{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "server.ts", "server-model.ts", "server-response.ts", "integration-server.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
